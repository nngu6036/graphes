+def _dataset_reference(
+    model: str,
+    args: argparse.Namespace,
+    profile: DatasetCLIProfile,
+) -> DatasetReference:
+    config_path = Path(profile.dataset_config) if profile.dataset_config else None
+    return DatasetReference(
+        benchmark_id=args.dataset,
