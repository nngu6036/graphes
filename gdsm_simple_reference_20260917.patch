+            if training.estimated_graphs_path is not None
+            else None
+        ),
+        "training_ground_truth_graphs": (
+            str(training.ground_truth_graphs_path.resolve())
+            if training.ground_truth_graphs_path is not None
+            else None
+        ),
+        "training_ground_truth_model_view": (
