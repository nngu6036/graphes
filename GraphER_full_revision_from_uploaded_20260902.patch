+def _observed_categories(graphs, node_attribute: str, edge_attribute: str):
+    nodes = sorted(
+        {
+            data[node_attribute]
+            for graph in graphs
+            for _, data in graph.nodes(data=True)
+            if node_attribute in data
+        },
+        key=repr,
+    )
+    edges = sorted(
+        {
+            data[edge_attribute]
+            for graph in graphs
+            for _, _, data in graph.edges(data=True)
+            if edge_attribute in data
+        },
+        key=repr,
+    )
+    return nodes, edges
