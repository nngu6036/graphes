+def brute_counts(x,e):
+    out=Counter()
+    for i,j,k in itertools.combinations(range(len(x)),3):
+        if (e[i,j]>0)+(int(e[i,k]>0))+(int(e[j,k]>0))>=2:
+            out[canonical_triple(tuple(map(int,(x[i],x[j],x[k],e[i,j],e[i,k],e[j,k]))))]+=1
+    return out
