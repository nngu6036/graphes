+def _status(model: str, message: str, *, enabled: bool) -> None:
+    if not enabled:
+        return
+    timestamp = datetime.now(timezone.utc).isoformat(timespec="seconds")
+    print(
+        f"[run_{model}_baseline {timestamp}] {message}",
+        file=sys.stderr,
+        flush=True,
+    )
