+def test_managed_baseline_generation_is_auto_detected(tmp_path) -> None:
+    generation_dir = (
+        tmp_path
+        / "outputs"
+        / "baselines"
+        / "defog"
+        / "community_small"
+        / "seed_42"
+        / "generations"
+        / "seed_42_n_8"
+    )
+    generation_dir.mkdir(parents=True)
+    graphs_path = generation_dir / "base_graphs.pkl"
+    graphs_path.write_bytes(b"placeholder")
+    manifest_path = generation_dir / "manifest.json"
+    manifest_path.write_text(
+        json.dumps(
+            {
+                "format": "grapher_defog_generation_v1",
+                "model_id": "defog",
+                "base_graphs": {"path": "base_graphs.pkl"},
+            }
+        ),
+        encoding="utf-8",
+    )
+
+    resolved_path, manifest, resolved_manifest_path = resolve_generated_graph_path(
+        generation_dir
+    )
+
+    assert resolved_path == graphs_path
+    assert resolved_manifest_path == manifest_path
+    assert manifest is not None and manifest["model_id"] == "defog"
+    assert (
+        resolve_generated_stage(
+            {"pipeline": {"stage": "posthoc_correction"}},
+            resolved_path,
+            generation_manifest=manifest,
+        )
+        == "defog"
+    )
+    base_path, base_stage = resolve_base_graph_path(generation_dir)
+    assert base_path == graphs_path
+    assert base_stage == "defog_base"
+
+
+def test_refined_output_keeps_pipeline_stage_and_allows_override(tmp_path) -> None:
+    generation_dir = tmp_path / "corrected"
+    generation_dir.mkdir()
+    refined_path = generation_dir / "topology_refined_graphs.pkl"
+    refined_path.write_bytes(b"placeholder")
+
+    resolved_path, manifest, manifest_path = resolve_generated_graph_path(
+        generation_dir
+    )
+
+    assert resolved_path == refined_path
+    assert manifest is None
+    assert manifest_path is None
+    assert (
+        resolve_generated_stage(
+            {"pipeline": {"stage": "posthoc_correction"}},
+            resolved_path,
+        )
+        == "topology_final"
+    )
+    assert (
+        resolve_generated_stage(
+            {},
+            resolved_path,
+            explicit_stage="DeFoG 800k",
+        )
+        == "defog_800k"
+    )
 
 
