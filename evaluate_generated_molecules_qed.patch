+def _wasserstein_1d(values_a: Iterable[float], values_b: Iterable[float]) -> float | None:
+    """Exact 1-Wasserstein distance between two empirical 1-D samples.
+
+    This avoids adding SciPy as an evaluator dependency.  Each empirical sample
+    is assigned uniform mass, and the integral of the absolute CDF difference
+    is accumulated over the union of observed support points.
+    """
+
+    a = sorted(float(v) for v in values_a)
+    b = sorted(float(v) for v in values_b)
+    if not a or not b:
+        return None
+
+    i = 0
+    j = 0
+    n = len(a)
+    m = len(b)
+    previous = min(a[0], b[0])
+    distance = 0.0
+
+    while i < n or j < m:
+        next_a = a[i] if i < n else float("inf")
+        next_b = b[j] if j < m else float("inf")
+        current = min(next_a, next_b)
+
+        distance += (current - previous) * abs(i / n - j / m)
+
+        while i < n and a[i] == current:
+            i += 1
+        while j < m and b[j] == current:
+            j += 1
+        previous = current
+
+    return float(distance)
+
+
+def compute_qed(smiles: Iterable[str]) -> tuple[list[float], dict[str, Any]]:
+    """Compute RDKit QED for a collection of sanitizable SMILES.
+
+    QED is evaluated only on molecules represented by the supplied SMILES.
+    The caller therefore decides whether raw-valid or validity-corrected
+    generated molecules are used.
+    """
+
+    smiles = list(smiles)
+    Chem = require_rdkit()
+    try:
+        from rdkit.Chem import QED
+    except Exception as exc:
+        return [], {
+            "status": "not_available_or_failed",
+            "error": type(exc).__name__,
+        }
+
+    scores: list[float] = []
+    errors: Counter[str] = Counter()
+    for smi in smiles:
+        try:
+            mol = Chem.MolFromSmiles(str(smi))
+            if mol is None:
+                errors["MolFromSmilesFailed"] += 1
+                continue
+            Chem.SanitizeMol(mol)
+            scores.append(float(QED.qed(mol)))
+        except Exception as exc:
+            errors[type(exc).__name__] += 1
+
+    return scores, {
+        "status": "ok" if scores else "not_computed_empty_or_invalid_smiles",
+        "backend": "rdkit.Chem.QED.qed",
+        "num_input_smiles": int(len(smiles)),
+        "num_scored": int(len(scores)),
+        "error_counts": dict(errors),
+    }
+
+
+def _qed_summary(scores: Iterable[float]) -> dict[str, float | int | None]:
+    values = sorted(float(v) for v in scores)
+    n = len(values)
+    if n == 0:
+        return {
+            "count": 0,
+            "mean": None,
+            "std": None,
+            "median": None,
+            "max": None,
+            "min": None,
+        }
+
+    mean = sum(values) / n
+    variance = sum((v - mean) ** 2 for v in values) / n
+    if n % 2:
+        median = values[n // 2]
+    else:
+        median = 0.5 * (values[n // 2 - 1] + values[n // 2])
+
+    return {
+        "count": int(n),
+        "mean": float(mean),
+        "std": float(variance ** 0.5),
+        "median": float(median),
+        "max": float(values[-1]),
+        "min": float(values[0]),
+    }
+
