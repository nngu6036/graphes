-            │   │   ├── estimated_graphs.pkl
-            │   │   ├── ground_truth_graphs.pkl
-            │   │   ├── ground_truth_model_view.pkl  # molecular, when needed
-            │   │   ├── manifest.json
-            │   │   └── native/
-            │   └── checkpoints/
-            └── generations/
-                └── <generation_id>/
-                    ├── base_graphs.pkl
-                    ├── manifest.json
-                    ├── generate.log
-                    └── native/
