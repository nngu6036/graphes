+    defaults.update(config)
+    defaults["variant"] = variant
+    defaults["max_num_node"] = max_num_node
+    defaults["max_prev_node"] = max_prev_node
+
+    positive_ints = (
+        "hidden_size_rnn",
+        "hidden_size_rnn_output",
+        "embedding_size_rnn",
+        "embedding_size_rnn_output",
+        "embedding_size_output",
