+        f"{'Comparison':30s}"
+        f"{'Degree MMD':>14s}"
+        f"{'Clustering MMD':>18s}"
+        f"{'Orbit MMD':>14s}"
+    )
+    for row in rows:
+        print(
+            f"{str(row['comparison']):30s}"
+            f"{float(row['degree_mmd']):14.6f}"
+            f"{float(row['clustering_mmd']):18.6f}"
+            f"{float(row['orbit_mmd']):14.6f}"
+        )
