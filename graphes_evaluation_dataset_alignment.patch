+            {
+                "source_dataset": "sbm",
+                "num_blocks": k,
+                "block_sizes": sizes,
+                "p_in": spec.p_in,
+                "p_out": spec.p_out,
+                "p_inter": spec.p_inter,
+                "p_inter_edge_probability": (
+                    inter_probability if spec.p_inter is not None else None
+                ),
+                "inter_edges_per_node_fraction": spec.inter_edges_per_node_fraction,
+                "seed": graph_seed,
