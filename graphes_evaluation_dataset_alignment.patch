+    node_size = max(90, min(360, int(9000 / max(graph.number_of_nodes(), 1))))
+    nx.draw_networkx_edges(
+        graph,
+        positions,
+        ax=axis,
+        width=edge_widths,
+        edge_color=edge_colors,
+        alpha=0.8,
+    )
+    nx.draw_networkx_nodes(
+        graph,
+        positions,
+        ax=axis,
+        node_color=node_colors,
+        node_size=node_size,
+        edgecolors="#111827",
+        linewidths=0.6,
+    )
+    if labels:
+        nx.draw_networkx_labels(
