+        "seed": 7,
+        "num_graphs": 8,
+        "communities": {
+            "min_blocks": 2,
+            "max_blocks": 2,
+            "min_total_nodes": 12,
+            "max_total_nodes": 20,
+            "equal_block_sizes": True,
+        },
+        "edge_probs": {
+            "p_in": 1.0,
+            "p_out": 0.0,
+            "p_inter": 0.05,
+            "ensure_inter_community_edge": True,
+        },
+        "filters": {
+            "require_connected": True,
+            "reject_zero_degree": True,
+            "max_attempts_per_graph": 20,
+        },
+    }
