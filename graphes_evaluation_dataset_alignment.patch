+            g.graph.update(
+                {
+                    "source_dataset": source_dataset,
+                    "dataset_type": "grid",
+                    "rows": rows,
+                    "cols": cols,
+                    "seed": graph_seed,
+                }
+            )
+            graphs.append(g)
+
+        if len(graphs) < num_graphs:
+            raise RuntimeError(
+                f"Could not build {num_graphs} grid graphs; got {len(graphs)}."
+            )
+        return graphs
