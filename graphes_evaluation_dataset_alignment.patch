+            positions,
+            labels=labels,
+            ax=axis,
+            font_size=8,
+            font_color="white",
+        )
+    axis.set_title(
+        f"Sample {graph_index + 1}\n"
+        f"$|V|={graph.number_of_nodes()}$, $|E|={graph.number_of_edges()}$",
+        fontsize=9,
+    )
+    axis.set_axis_off()
