+def main(model_id: str, argv: Sequence[str] | None = None) -> int:
+    model = normalize_baseline_id(model_id)
+    parser = build_parser(model)
+    args = parser.parse_args(argv)
+    try:
+        summary = run(model, args)
+    except Exception as exc:
